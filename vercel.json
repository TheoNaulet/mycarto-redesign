{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build && pnpm build-storybook --quiet -o dist/storybook",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/storybook", "destination": "/storybook/", "permanent": true }],
  "rewrites": [{ "source": "/((?!storybook/).*)", "destination": "/index.html" }]
}
